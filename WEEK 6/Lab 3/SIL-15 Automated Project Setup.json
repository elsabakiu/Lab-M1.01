    },
    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body;\nconst issue = body.issue;\nconst fields = issue.fields;\nconst user = body.user;\n\nconst consultants = fields.customfield_assigned_consultants || [];\n\nif (!Array.isArray(consultants) || consultants.length === 0) {\n  throw new Error('No consultants found in customfield_assigned_consultants');\n}\n\nconst issueKey = issue.key;\nconst projectName = fields.customfield_project_name || fields.summary;\nconst projectKey = fields.project.key;\nconst startDate = fields.customfield_start_date;\nconst endDate = fields.customfield_end_date;\nconst approvedBy = user.displayName;\nconst approvedByEmail = user.emailAddress;\nconst jiraBaseUrl = 'https://ai-consulting-eb.atlassian.net';\nconst runTimestamp = new Date().toISOString();\n\n// Output one item per consultant for individual Slack DMs\nreturn consultants.map(consultant => ({\n  json: {\n    accountId: consultant.accountId,\n    displayName: consultant.displayName,\n    emailAddress: consultant.emailAddress,\n    slackUserId: consultant.slackUserId || null,\n    role: consultant.role,\n    skillMatchScore: consultant.skillMatchScore,\n    currentUtilization: consultant.currentUtilization,\n    issueKey,\n    projectName,\n    projectKey,\n    startDate,\n    endDate,\n    approvedBy,\n    approvedByEmail,\n    jiraBaseUrl,\n    runTimestamp\n  }\n}));"
      },
