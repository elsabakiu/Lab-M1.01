    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body;\nconst issue = body.issue;\nconst fields = issue.fields;\nconst user = body.user;\n\nconst consultants = fields.customfield_assigned_consultants || [];\n\nif (!Array.isArray(consultants) || consultants.length === 0) {\n  throw new Error('No consultants found in customfield_assigned_consultants');\n}\n\n// Build a comma-separated attendee email string for the calendar invite\nconst attendeeEmails = consultants.map(c => c.emailAddress).join(',');\n\n// Add the approving PM too\nconst allAttendeeEmails = attendeeEmails + ',' + user.emailAddress;\n\nconst issueKey = issue.key;\nconst projectName = fields.customfield_project_name || fields.summary;\nconst projectKey = fields.project.key;\nconst startDate = fields.customfield_start_date;\nconst endDate = fields.customfield_end_date;\nconst approvedBy = user.displayName;\nconst approvedByEmail = user.emailAddress;\nconst allocationNotes = fields.customfield_allocation_notes || '';\nconst jiraBaseUrl = 'https://ai-consulting-eb.atlassian.net';\nconst runTimestamp = new Date().toISOString();\n\nconst teamSummary = consultants\n  .map(c => c.displayName + ' (' + c.role + ')')\n  .join(', ');\n\n// Output a single item for the calendar node\nreturn [{\n  json: {\n    issueKey,\n    projectName,\n    projectKey,\n    startDate,\n    endDate,\n    approvedBy,\n    approvedByEmail,\n    allocationNotes,\n    jiraBaseUrl,\n    runTimestamp,\n    teamSummary,\n    attendeeEmails: allAttendeeEmails,\n    consultants\n  }\n}];"
      },
      "id": "c89fe211-ba7b-4f09-a87a-719a3e45e002",
      "name": "Prepare Calendar Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        384,
