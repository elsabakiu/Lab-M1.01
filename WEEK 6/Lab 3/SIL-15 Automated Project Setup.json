      "parameters": {
        "jsCode": "// Pull original data directly from Prepare Calendar Data node\n// regardless of what Calendar/Slack nodes did to the items\nconst ref = $('Prepare Calendar Data').first().json;\nconst consultants = ref.consultants || [];\n\nconst teamLines = consultants\n  .map(c => '  • ' + c.displayName + ' (' + c.role + ') — Skill match: ' + c.skillMatchScore + '%')\n  .join('\\n');\n\nconst commentBody = '✅ *Automated Project Setup Complete*\\n\\n'\n  + '*Triggered:* ' + ref.runTimestamp + '\\n'\n  + '*Issue:* ' + ref.issueKey + '\\n'\n  + '*Project:* ' + ref.projectName + ' (' + ref.projectKey + ')\\n'\n  + '*Period:* ' + ref.startDate + ' → ' + ref.endDate + '\\n'\n  + '*Approved by:* ' + ref.approvedBy + '\\n\\n'\n  + '*Assigned Team:*\\n' + teamLines + '\\n\\n'\n  + '*Actions completed:*\\n'\n  + '  • 1 Google Calendar invite sent to full team\\n'\n  + '  • ' + consultants.length + ' individual Slack notifications sent\\n'\n  + '  • This comment posted as audit record\\n\\n'\n  + '_Automated by n8n SIL-15 workflow_';\n\nreturn [{\n  json: {\n    issueKey: ref.issueKey,\n    jiraBaseUrl: ref.jiraBaseUrl,\n    commentBody,\n    consultantCount: consultants.length\n  }\n}];"
      },
