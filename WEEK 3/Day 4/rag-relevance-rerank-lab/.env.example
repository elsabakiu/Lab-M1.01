DOCS_LANGCHAIN_MCP_URL=https://docs.langchain.com/mcp

OPENAI_API_KEY=your_openai_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
